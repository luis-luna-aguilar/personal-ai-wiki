    rdfs:domain [ a owl:Class ; owl:unionOf ( org:Organization schema:SoftwareApplication ) ] ;
    rdfs:range owl:Thing .

biz:develops a owl:ObjectProperty ;
    rdfs:label "develops"@en ;
    rdfs:comment "Develops a software product (e.g. NAVI)."@en ;
