biz:maps a owl:ObjectProperty ;
    rdfs:label "maps"@en ;
    rdfs:comment "Maps every step of the redemption journey."@en ;
    rdfs:domain biz:JourneyMapping ;
    rdfs:range biz:RedemptionJourney .

biz:maximizes a owl:ObjectProperty ;
    rdfs:label "maximizes"@en ;
    rdfs:comment "Maximizes perceived program value."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

biz:meetsWith a owl:ObjectProperty ;
    rdfs:label "meets with"@en ;
    rdfs:comment "MUSCLE meets with the bank during a virtual session."@en ;
    rdfs:domain org:Organization ;
    rdfs:range org:Organization .

biz:occursIn a owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    rdfs:comment "A process occurs within a named product (e.g. Control Tower)."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range schema:SoftwareApplication .

biz:operates a owl:ObjectProperty ;
    rdfs:label "operates"@en ;
    rdfs:comment "Operates a network of branches and ATMs."@en ;
    rdfs:domain org:Organization ;
    rdfs:range owl:Thing .

biz:optimizes a owl:ObjectProperty ;
    rdfs:label "optimizes"@en ;
    rdfs:comment "Optimizes bank loyalty programs."@en ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range owl:Thing .

biz:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:subPropertyOf time:before ;
    rdfs:comment "Plain sequential ordering of the 4-step protocol ('Form before Virtual-Session before Confirmation before Activation') — not an entity hand-off between activities, so `prov:wasInformedBy` would misuse its narrower communication semantics. `rdfs:subPropertyOf time:before` (W3C OWL-Time), narrowed."@en ;
    rdfs:domain biz:ProtocolStep ;
    rdfs:range biz:ProtocolStep .

biz:prices a owl:ObjectProperty ;
    rdfs:label "prices"@en ;
    rdfs:comment "Dynamically prices rewards by route or segment."@en ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range owl:Thing .

biz:provides a owl:ObjectProperty ;
    rdfs:label "provides"@en ;
    rdfs:comment "Provides core infrastructure / AI models — an organization, or a software application providing one of its own capabilities. Domain widened under VCR 0015, same disjointness fix as biz:offers."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( org:Organization schema:SoftwareApplication ) ] ;
    rdfs:range schema:Product .

biz:purchasesOn a owl:ObjectProperty ;
    rdfs:label "purchases on"@en ;
    rdfs:comment "Makes purchases natively on a partner marketplace (e.g. Shopstar)."@en ;
    rdfs:domain biz:Cardholder ;
    rdfs:range schema:SoftwareApplication .

biz:receives a owl:ObjectProperty ;
    rdfs:label "receives"@en ;
    rdfs:comment "Receives a configuration form / email confirmation."@en ;
    rdfs:domain fibo-fbc-fct-fse:Bank ;
    rdfs:range owl:Thing .

biz:recommends a owl:ObjectProperty ;
    rdfs:label "recommends"@en ;
    rdfs:comment "Recommends tailored destinations and dates."@en ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range owl:Thing .

biz:reduces a owl:ObjectProperty ;
    rdfs:label "reduces"@en ;
    rdfs:comment "Reduces point liabilities."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

biz:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:comment "A conditional requirement between two facts. Domain deliberately open (was skos:Concept, widened by VCR-0018): software and organizations legitimately require things too."@en ;
    rdfs:range owl:Thing .

biz:servesIndustry a owl:ObjectProperty ;
    rdfs:label "serves industry"@en ;
    rdfs:comment "A product/platform serves customers in an industry vertical (a skos:Concept tag). Distinct from biz:serves, whose range is org:Organization (serving a specific organization). See VCR-0018."@en ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range skos:Concept .

biz:LoyaltyProgram a owl:Class ;
    rdfs:label "Loyalty Program"@en ;
    rdfs:comment "A points/miles loyalty program operated by an organization (in MUSCLE's domain, a bank's cardholder program). See VCR-0018."@en .

biz:restrictsBy a owl:ObjectProperty ;
    rdfs:label "restricts by"@en ;
    rdfs:comment "Restricts a channel condition by a vertical-specific value (route scope, retail category, location boundary). Domain now resolvable — see C1's `biz:ChannelRestriction`."@en ;
    rdfs:domain biz:ChannelRestriction ;
    rdfs:range owl:Thing .

biz:scales a owl:ObjectProperty ;
    rdfs:label "scales"@en ;
    rdfs:comment "Scales a loyalty program. New in this pass."@en ;
    rdfs:domain org:Organization ;
    rdfs:range owl:Thing .

biz:selects a owl:ObjectProperty ;
    rdfs:label "selects"@en ;
    rdfs:comment "Selects the primary channel during configuration."@en ;
    rdfs:domain org:Role ;
    rdfs:range owl:Thing .

biz:serves a owl:ObjectProperty ;
    rdfs:label "serves"@en ;
    rdfs:comment "Designed specifically to serve banks."@en ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range org:Organization .

biz:transforms a owl:ObjectProperty ;
    rdfs:label "transforms"@en ;
    rdfs:comment "Transforms points into personalized travel experiences."@en ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range owl:Thing .

biz:triggers a owl:ObjectProperty ;
    rdfs:label "triggers"@en ;
    rdfs:comment "A discount's activation triggers a UI message."@en ;
    rdfs:domain biz:Discount ;
    rdfs:range swe:UIComponent .

biz:views a owl:ObjectProperty ;
    rdfs:label "views"@en ;
    rdfs:comment "Views (but does not download) reports."@en ;
    rdfs:domain org:Role ;
    rdfs:range owl:Thing .

