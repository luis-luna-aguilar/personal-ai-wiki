    rdfs:range owl:Thing .

biz:improves a owl:ObjectProperty ;
    rdfs:label "improves"@en ;
    rdfs:comment "Improves the cardholder experience."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

biz:includesStage a owl:ObjectProperty ;
    rdfs:label "includes stage"@en ;
    rdfs:subPropertyOf dct:hasPart ;
    rdfs:comment "A process includes a stage as part of it. `rdfs:subPropertyOf dcterms:hasPart`, narrowed."@en ;
    rdfs:domain biz:Process ;
    rdfs:range biz:ProcessStage .

biz:includesStep a owl:ObjectProperty ;
    rdfs:label "includes step"@en ;
    rdfs:subPropertyOf dct:hasPart ;
    rdfs:comment "A process includes a step as part of it. `rdfs:subPropertyOf dcterms:hasPart`, narrowed."@en ;
    rdfs:domain biz:Process ;
    rdfs:range biz:ProtocolStep .

biz:isUsedIn a owl:ObjectProperty ;
    rdfs:label "is used in"@en ;
    rdfs:comment "Used in a platform demonstration."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range biz:Demonstration .

biz:issues a owl:ObjectProperty ;
    rdfs:label "issues"@en ;
    rdfs:comment "Issues an initial access password."@en ;
    rdfs:domain org:Organization ;
