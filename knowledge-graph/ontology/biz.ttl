#####################################################################
# VCR 0020 — Corporate legal-entity vocabulary (ownership, advisors,
# compliance, bank accounts, financing, IP). All classes pass the
# portability test (§6b) — generic corporate/legal vocabulary any
# company could use, none of it MUSCLE-product-specific.
#####################################################################

# External class stubs used as domain/range below (full definitions live
# in upstream extracts once merge-tbox.sh runs).
org:Membership              a owl:Class .
prov:Agent                  a owl:Class .
schema:Person                a owl:Class .
schema:DigitalDocument       a owl:Class .
schema:MonetaryAmount        a owl:Class .
schema:PropertyValue         a owl:Class .
schema:PostalAddress         a owl:Class .
schema:State                 a owl:Class .

biz:OwnershipStake a owl:Class ;
    rdfs:label "Ownership Stake"@en ;
    rdfs:comment "A reified holding of a percentage stake in an organization by an agent (org or person). Reified — not a flat percentage on the owned org — because several MUSCLE entities have multi-party cap tables. Aligned to FIBO's BE/OwnershipAndControl/OwnershipParties#EntityOwnership (see alignments.ttl)."@en .

biz:hasOwnershipStake a owl:ObjectProperty ;
    rdfs:label "has ownership stake"@en ;
    rdfs:comment "The owned organization has a stake held in it."@en ;
    rdfs:domain org:Organization ;
    rdfs:range biz:OwnershipStake .

biz:heldBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "held by"@en ;
    rdfs:comment "The agent (organization or natural person) who holds an ownership stake."@en ;
    rdfs:domain biz:OwnershipStake ;
    rdfs:range prov:Agent .

biz:ownershipPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership percentage"@en ;
    rdfs:comment "The percentage of the owned organization this stake represents. \"99.999%\"."@en ;
    rdfs:domain biz:OwnershipStake ;
    rdfs:range xsd:decimal .

biz:AdvisoryEngagement a owl:Class ;
    rdfs:label "Advisory Engagement"@en ;
    rdfs:comment "A reified engagement of a legal/accounting/registered-agent/investment-manager firm by an entity, carrying which role the firm serves and its contact."@en .

biz:hasAdvisoryEngagement a owl:ObjectProperty ;
    rdfs:label "has advisory engagement"@en ;
    rdfs:comment "The organization engages an advisor."@en ;
    rdfs:domain org:Organization ;
    rdfs:range biz:AdvisoryEngagement .

biz:AdvisoryRole a owl:Class ;
    rdfs:label "Advisory Role"@en ;
    rdfs:comment "Enumeration of the kind of professional service an AdvisoryEngagement covers."@en ;
    owl:oneOf ( biz:legal-counsel biz:tax-advisor biz:accounting-advisor biz:registered-agent
                biz:transfer-pricing-advisor biz:corporate-secretarial biz:investment-manager ) .

biz:advisoryRole a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "advisory role"@en ;
    rdfs:comment "Which role the engagement covers."@en ;
    rdfs:domain biz:AdvisoryEngagement ;
    rdfs:range biz:AdvisoryRole .

biz:legal-counsel a biz:AdvisoryRole ; rdfs:label "Legal Counsel"@en .
biz:tax-advisor a biz:AdvisoryRole ; rdfs:label "Tax Advisor"@en .
biz:accounting-advisor a biz:AdvisoryRole ; rdfs:label "Accounting Advisor"@en .
biz:registered-agent a biz:AdvisoryRole ; rdfs:label "Registered Agent"@en .
biz:transfer-pricing-advisor a biz:AdvisoryRole ; rdfs:label "Transfer Pricing Advisor"@en .
biz:corporate-secretarial a biz:AdvisoryRole ; rdfs:label "Corporate Secretarial"@en .
biz:investment-manager a biz:AdvisoryRole ; rdfs:label "Investment Manager"@en .

biz:providedBy a owl:ObjectProperty ;
    rdfs:label "provided by"@en ;
    rdfs:comment "The firm/bank/lender providing an advisory engagement, financing instrument, or (on a compliance obligation) executing a filing on the entity's behalf."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range org:FormalOrganization .

biz:primaryContact a owl:ObjectProperty ;
    rdfs:label "primary contact"@en ;
    rdfs:comment "The named contact(s) for an advisory engagement or bank account. Not functional — a source often lists both a primary and secondary contact."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range schema:Person .

biz:ComplianceObligation a owl:Class ;
    rdfs:label "Compliance Obligation"@en ;
    rdfs:comment "A reified recurring or one-off regulatory filing/payment obligation an entity owes a regulator."@en .

biz:hasComplianceObligation a owl:ObjectProperty ;
    rdfs:label "has compliance obligation"@en ;
    rdfs:comment "The organization owes a compliance obligation."@en ;
    rdfs:domain org:Organization ;
    rdfs:range biz:ComplianceObligation .

biz:regulatedBy a owl:ObjectProperty ;
    rdfs:label "regulated by"@en ;
    rdfs:comment "The regulator/authority a compliance obligation is owed to."@en ;
    rdfs:domain biz:ComplianceObligation ;
    rdfs:range org:FormalOrganization .

biz:hasObligationCost a owl:ObjectProperty ;
    rdfs:label "has obligation cost"@en ;
    rdfs:comment "The obligation's fee/assessment, reified as a schema:MonetaryAmount (Rule 10) rather than a bare decimal."@en ;
    rdfs:domain biz:ComplianceObligation ;
    rdfs:range schema:MonetaryAmount .

biz:hasDeadlineDescription a owl:DatatypeProperty ;
    rdfs:label "has deadline description"@en ;
    rdfs:comment "Free-text recurring/relative deadline (\"Before 31 March each year\") — no closed-form recurrence vocabulary imported yet, so this stays a string rather than a modeled recurrence rule."@en ;
    rdfs:domain biz:ComplianceObligation ;
    rdfs:range xsd:string .

biz:ComplianceObligationFrequency a owl:Class ;
    rdfs:label "Compliance Obligation Frequency"@en ;
    rdfs:comment "Enumeration of how often a ComplianceObligation recurs."@en ;
    owl:oneOf ( biz:annual biz:monthly biz:semi-annual biz:ongoing biz:once biz:per-movement ) .

biz:hasComplianceObligationFrequency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has compliance obligation frequency"@en ;
    rdfs:comment "How often the obligation recurs."@en ;
    rdfs:domain biz:ComplianceObligation ;
    rdfs:range biz:ComplianceObligationFrequency .

biz:annual a biz:ComplianceObligationFrequency ; rdfs:label "Annual"@en .
biz:monthly a biz:ComplianceObligationFrequency ; rdfs:label "Monthly"@en .
biz:semi-annual a biz:ComplianceObligationFrequency ; rdfs:label "Semi-Annual"@en .
biz:ongoing a biz:ComplianceObligationFrequency ; rdfs:label "Ongoing"@en .
biz:once a biz:ComplianceObligationFrequency ; rdfs:label "Once"@en .
biz:per-movement a biz:ComplianceObligationFrequency ; rdfs:label "Per Movement"@en .

biz:BankAccount a owl:Class ;
    rdfs:label "Bank Account"@en ;
    rdfs:comment "A reified operating/brokerage bank account held by an organization."@en .

biz:hasBankAccount a owl:ObjectProperty ;
    rdfs:label "has bank account"@en ;
    rdfs:comment "The organization holds a bank account."@en ;
    rdfs:domain org:Organization ;
    rdfs:range biz:BankAccount .

biz:accountHolderBank a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account holder bank"@en ;
    rdfs:comment "Which bank the account is held at."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range fibo-fbc-fct-fse:Bank .

biz:brokerIntermediary a owl:ObjectProperty ;
    rdfs:label "broker intermediary"@en ;
    rdfs:comment "A brokerage account's broker/intermediary, distinct from the custodian bank in accountHolderBank."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range org:FormalOrganization .

biz:accountNumber a owl:DatatypeProperty ;
    rdfs:label "account number"@en ;
    rdfs:comment "An opaque account-number identifier — no enumerable domain to validate beyond presence."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:iban a owl:DatatypeProperty ;
    rdfs:label "IBAN"@en ;
    rdfs:comment "International Bank Account Number."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:swiftCode a owl:DatatypeProperty ;
    rdfs:label "SWIFT code"@en ;
    rdfs:comment "ISO 9362 SWIFT/BIC code."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:accountCurrency a owl:DatatypeProperty ;
    rdfs:label "account currency"@en ;
    rdfs:comment "ISO 4217 currency code."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:abaRoutingNumber a owl:DatatypeProperty ;
    rdfs:label "ABA routing number"@en ;
    rdfs:comment "US ABA bank routing number — always exactly 9 digits."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:dtccClearingNumber a owl:DatatypeProperty ;
    rdfs:label "DTCC clearing number"@en ;
    rdfs:comment "DTCC clearing broker number — always exactly 4 digits."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:cci a owl:DatatypeProperty ;
    rdfs:label "CCI"@en ;
    rdfs:comment "Peru's Código de Cuenta Interbancario — a 20-digit interbank routing code, distinct from IBAN/SWIFT/ABA."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:beneficiaryReference a owl:DatatypeProperty ;
    rdfs:label "beneficiary reference"@en ;
    rdfs:comment "An opaque \"for further credit to\" sub-account/beneficiary reference string."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range xsd:string .

biz:authorizedSignatory a owl:ObjectProperty ;
    rdfs:label "authorized signatory"@en ;
    rdfs:comment "A person authorized to operate the account."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range schema:Person .

biz:BankAccountStatus a owl:Class ;
    rdfs:label "Bank Account Status"@en ;
    rdfs:comment "Enumeration of a BankAccount's operating status."@en ;
    owl:oneOf ( biz:active biz:dormant biz:closed-pending ) .

biz:accountStatus a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account status"@en ;
    rdfs:comment "The account's current operating status."@en ;
    rdfs:domain biz:BankAccount ;
    rdfs:range biz:BankAccountStatus .

biz:active a biz:BankAccountStatus ; rdfs:label "Active"@en .
biz:dormant a biz:BankAccountStatus ; rdfs:label "Dormant"@en .
biz:closed-pending a biz:BankAccountStatus ; rdfs:label "Closed/Pending"@en .

biz:FinancingInstrument a owl:Class ;
    rdfs:label "Financing Instrument"@en ;
    rdfs:comment "A reified credit facility, credit card, or intercompany loan extended to an entity."@en .

biz:hasFinancingInstrument a owl:ObjectProperty ;
    rdfs:label "has financing instrument"@en ;
    rdfs:comment "The organization holds a financing instrument."@en ;
    rdfs:domain org:Organization ;
    rdfs:range biz:FinancingInstrument .

biz:FinancingInstrumentType a owl:Class ;
    rdfs:label "Financing Instrument Type"@en ;
    rdfs:comment "Enumeration of FinancingInstrument kinds."@en ;
    owl:oneOf ( biz:revolving-credit-line biz:overdraft-facility biz:standby-letter-of-credit
                biz:working-capital-facility biz:intercompany-loan biz:credit-card ) .

biz:instrumentType a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "instrument type"@en ;
    rdfs:comment "Which kind of financing instrument."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range biz:FinancingInstrumentType .

biz:revolving-credit-line a biz:FinancingInstrumentType ; rdfs:label "Revolving Credit Line"@en .
biz:overdraft-facility a biz:FinancingInstrumentType ; rdfs:label "Overdraft Facility"@en .
biz:standby-letter-of-credit a biz:FinancingInstrumentType ; rdfs:label "Standby Letter of Credit"@en .
biz:working-capital-facility a biz:FinancingInstrumentType ; rdfs:label "Working Capital Facility"@en .
biz:intercompany-loan a biz:FinancingInstrumentType ; rdfs:label "Intercompany Loan"@en .
biz:credit-card a biz:FinancingInstrumentType ; rdfs:label "Credit Card"@en .

biz:facilityLimit a owl:ObjectProperty ;
    rdfs:label "facility limit"@en ;
    rdfs:comment "The instrument's credit limit, reified as a schema:MonetaryAmount (Rule 10)."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range schema:MonetaryAmount .

biz:facilityFee a owl:ObjectProperty ;
    rdfs:label "facility fee"@en ;
    rdfs:comment "A one-time facility/arrangement fee, distinct from the ongoing facilityLimit ceiling."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range schema:MonetaryAmount .

biz:engagementFee a owl:ObjectProperty ;
    rdfs:label "engagement fee"@en ;
    rdfs:comment "A recurring or one-time advisor fee."@en ;
    rdfs:domain biz:AdvisoryEngagement ;
    rdfs:range schema:MonetaryAmount .

biz:interestRateDescription a owl:DatatypeProperty ;
    rdfs:label "interest rate description"@en ;
    rdfs:comment "Free-text compound/variable interest-rate formula — no rate-index ontology imported yet, so this stays a string."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range xsd:string .

biz:cardLastFourDigits a owl:DatatypeProperty ;
    rdfs:label "card last four digits"@en ;
    rdfs:comment "The last 4 digits of a credit card — always exactly 4 digits."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range xsd:string .

biz:guarantor a owl:ObjectProperty ;
    rdfs:label "guarantor"@en ;
    rdfs:comment "A joint guarantor (\"Fiador Solidario\") on a financing instrument. Non-functional — an instrument can have several."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range schema:Person .

biz:beneficiary a owl:ObjectProperty ;
    rdfs:label "beneficiary"@en ;
    rdfs:comment "The beneficiary of a standby letter of credit, distinct from the issuing bank in providedBy."@en ;
    rdfs:domain biz:FinancingInstrument ;
    rdfs:range org:FormalOrganization .

biz:SigningScope a owl:Class ;
    rdfs:label "Signing Scope"@en ;
    rdfs:comment "Whether an org:Membership's signing authority may be exercised alone or requires co-signers."@en ;
    owl:oneOf ( biz:individual biz:joint biz:joint-and-several ) .

biz:signingScope a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "signing scope"@en ;
    rdfs:comment "Whether the membership's signing authority is individual or requires co-signers."@en ;
    rdfs:domain org:Membership ;
    rdfs:range biz:SigningScope .

biz:individual a biz:SigningScope ; rdfs:label "Individual"@en .
biz:joint a biz:SigningScope ; rdfs:label "Joint"@en .
biz:joint-and-several a biz:SigningScope ; rdfs:label "Joint and Several"@en .

biz:Patent a owl:Class ;
    rdfs:label "Patent"@en ;
    rdfs:comment "An issued patent held by an organization."@en .

biz:holdsPatent a owl:ObjectProperty ;
    rdfs:label "holds patent"@en ;
    rdfs:comment "An organization owns a patent."@en ;
    rdfs:domain org:Organization ;
    rdfs:range biz:Patent .

biz:patentNumber a owl:DatatypeProperty ;
    rdfs:label "patent number"@en ;
    rdfs:comment "An opaque patent-number identifier."@en ;
    rdfs:domain biz:Patent ;
    rdfs:range xsd:string .

biz:patentIssueDate a owl:DatatypeProperty ;
    rdfs:label "patent issue date"@en ;
    rdfs:comment "The date a patent was issued."@en ;
    rdfs:domain biz:Patent ;
    rdfs:range xsd:date .

biz:assignedBy a owl:ObjectProperty ;
    rdfs:label "assigned by"@en ;
    rdfs:comment "A natural-person assignor named in a patent's assignment record. Non-functional — a patent can have several assignors. Distinct from holdsPatent, which records the current owning organization."@en ;
    rdfs:domain biz:Patent ;
    rdfs:range schema:Person .

biz:authorizedActivity a owl:ObjectProperty ;
    rdfs:label "authorized activity"@en ;
    rdfs:comment "An activity-classification code (e.g. Costa Rica's CAE-CR, Peru's CIIU) an organization is authorized to conduct under a regulatory grant (e.g. a Zona Franca concession). Non-functional. Distinct from schema:knowsAbout (a loose topic association): this states the entity's permitted commercial scope under a specific legal instrument, implying activities outside the set are not authorized under that grant."@en ;
    rdfs:domain org:Organization ;
    rdfs:range skos:Concept .

biz:hasIncorporationDate a owl:DatatypeProperty ;
    rdfs:label "has incorporation date"@en ;
    rdfs:comment "The entity's exact incorporation/formation date — distinct from schema:foundingDate, which is xsd:gYear-only and cannot carry day/month precision."@en ;
    rdfs:domain org:FormalOrganization ;
    rdfs:range xsd:date .

biz:hasFiscalYearEnd a owl:DatatypeProperty ;
    rdfs:label "has fiscal year end"@en ;
    rdfs:comment "The entity's fiscal year end, e.g. \"--12-31\" for 31 December."@en ;
    rdfs:domain org:FormalOrganization ;
    rdfs:range xsd:gMonthDay .

biz:hasCorporateDocument a owl:ObjectProperty ;
    rdfs:label "has corporate document"@en ;
    rdfs:comment "The organization has a named corporate document on file."@en ;
    rdfs:domain org:Organization ;
    rdfs:range schema:DigitalDocument .

# The 12 org:Role individuals below are generic corporate-governance roles (director,
# president, ...) — deliberately in biz:, not a product's own native module, per
# vocabulary-policy.md §6a's distinction from product-configuration/permission roles
# (the source project this layer was ported from kept those in its own `muscle:`
# module, e.g. muscle:admin/muscle:analyst; this deployment's org-role.md guide notes
# the pattern is currently dormant here — no ingested source describes a tool's
# per-role permission boundary in that much detail yet).
# W3C ORG's org:Role is itself a subclass of skos:Concept (upstream, not a native
# choice) — every org:Role individual falls under aiw:ConceptShape after reasoning,
# so each needs skos:prefLabel/skos:definition, same as any other dual-typed
# skos:Concept in this deployment (system/authoring-guides/org-role.md). Inherited
# from the source project, where this was found by validate-shacl.sh failing on
# these 11 during a rebuild — rdfs:label alone was not sufficient.
biz:director a org:Role ; rdfs:label "Director"@en ;
    skos:prefLabel "Director"@en ; skos:definition "A member of an organization's board of directors, collectively responsible for managing the business."@en .
biz:president a org:Role ; rdfs:label "President"@en ;
    skos:prefLabel "President"@en ; skos:definition "The chief executive officer role under civil-law corporate governance (\"Presidente\"), typically holding broad binding authority."@en .
biz:secretary a org:Role ; rdfs:label "Secretary"@en ;
    skos:prefLabel "Secretary"@en ; skos:definition "A corporate officer (\"Secretario\") responsible for corporate records and, in many jurisdictions, sharing binding signature authority with the President."@en .
biz:treasurer a org:Role ; rdfs:label "Treasurer"@en ;
    skos:prefLabel "Treasurer"@en ; skos:definition "A corporate officer (\"Tesorero\") responsible for the organization's financial affairs."@en .
biz:administrator a org:Role ; rdfs:label "Administrator"@en ;
    skos:prefLabel "Administrator"@en ; skos:definition "An officer (\"Administrador\") with full management and binding authority over the organization, as used in Sociedad de Responsabilidad Limitada structures."@en .
biz:manager a org:Role ; rdfs:label "Manager"@en ;
    skos:prefLabel "Manager"@en ; skos:definition "The manager of a member-managed limited liability company, responsible for day-to-day operations."@en .
biz:managing-member a org:Role ; rdfs:label "Managing Member"@en ;
    skos:prefLabel "Managing Member"@en ; skos:definition "The member of a limited liability company designated to manage it, per its operating agreement."@en .
biz:gerente-general a org:Role ; rdfs:label "Gerente General"@en ;
    skos:prefLabel "Gerente General"@en ; skos:definition "A general-manager role, sometimes held by a corporate entity (persona jurídica) acting through a named representative, with administrative and labor authority short of contracting or banking powers."@en .
biz:ceo a org:Role ; rdfs:label "CEO"@en ;
    skos:prefLabel "CEO"@en ; skos:definition "Chief Executive Officer — the senior executive responsible for overall management of the organization."@en .
biz:cto a org:Role ; rdfs:label "CTO"@en ;
    skos:prefLabel "CTO"@en ; skos:definition "Chief Technology Officer — the senior executive responsible for the organization's technology strategy."@en .
biz:apoderado-especial a org:Role ; rdfs:label "Apoderado Especial"@en ;
    skos:prefLabel "Apoderado Especial"@en ; skos:definition "A formal power-of-attorney holder under a defined Régimen de Poderes, with full authority and no monetary cap, distinct from a general legal representative."@en .
