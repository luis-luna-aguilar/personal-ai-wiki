@prefix biz:    <https://musclepoints.com/ontology/biz#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix fibo-fnd-utl-alx: <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/> .
@prefix swe:    <https://musclepoints.com/ontology/swe#> .
@prefix travel: <https://musclepoints.com/ontology/travel#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .

<https://musclepoints.com/ontology/biz> a owl:Ontology ;
    rdfs:label "Business Vocabulary"@en ;
    rdfs:comment "A domain-named, reusable vocabulary for general commercial relations that have no upstream home (client-of, uses-product, priority rank). Authored by MUSCLE but free of MUSCLE-specific business logic — it would apply to any company. See knowledge-graph/governance/change-requests/0002-business-vocab.md."@en ;
    owl:versionInfo "0.2.0" .

#####################################################################
# External class stubs — full definitions live in upstream extracts.
#####################################################################

org:Organization           a owl:Class .
org:Role                   a owl:Class .
schema:SoftwareApplication a owl:Class .
schema:Product             a owl:Class .
fibo-fnd-utl-alx:KeyPerformanceIndicator a owl:Class .
swe:ReportingModule        a owl:Class .
fibo-fbc-fct-fse:Bank      a owl:Class .

#####################################################################
# Commercial relations
#####################################################################

biz:clientOf a owl:ObjectProperty ;
    rdfs:label "client of"@en ;
    rdfs:comment "The subject organization is an ongoing commercial client of the object organization. Researched: FIBO has Customer/Client classes but no inverse property; schema:customer is transactional (domain Order); GoodRelations models offering eligibility, not ongoing client-of-provider relationships."@en ;
    rdfs:domain org:Organization ;
    rdfs:range org:Organization ;
    owl:inverseOf biz:hasClient .

biz:hasClient a owl:ObjectProperty ;
    rdfs:label "has client"@en ;
    rdfs:comment "The subject organization has the object organization as an ongoing commercial client."@en ;
    rdfs:domain org:Organization ;
    rdfs:range org:Organization ;
    owl:inverseOf biz:clientOf .

biz:usesProduct a owl:ObjectProperty ;
    rdfs:label "uses product"@en ;
    rdfs:comment "The organization uses or has deployed a software application as a product. Researched: schema.org has no direct 'uses'/'deploys' property on Organization; schema:UseAction is an Action-pattern workaround; DOAP has no adopter property."@en ;
    rdfs:domain org:Organization ;
    rdfs:range schema:SoftwareApplication .

biz:hasPriorityRank a owl:DatatypeProperty ;
    rdfs:label "has priority rank"@en ;
    rdfs:comment "A numeric precedence weight determining which item applies when several qualify simultaneously (lower-or-higher precedence per the using context's fallback logic). Domain intentionally left open so the term stays general; any MUSCLE-specific constraint (e.g. that a PricingStrategy must carry one) is expressed by a SHACL shape in the MUSCLE layer, not here."@en ;
    rdfs:range xsd:integer .

#####################################################################
# Business and Industry Modalities (as Concepts)
#####################################################################

biz:retail-banking a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Retail Banking"@en ;
    skos:prefLabel "Retail Banking"@en ;
    skos:definition "Banking services oriented towards individual consumers rather than large corporations, including checking and savings accounts, mortgages, credit cards, and personal loans."@en .

biz:corporate-finance a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Corporate Finance"@en ;
    skos:prefLabel "Corporate Finance"@en ;
    skos:definition "The area of finance dealing with the sources of funding and the capital structure of corporations, the actions that managers take to increase the value of the company to the shareholders, and the tools and analysis used to allocate financial resources."@en .

biz:wealth-management a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Wealth Management"@en ;
    skos:prefLabel "Wealth Management"@en ;
    skos:definition "An investment-advisory discipline which incorporates financial planning, investment portfolio management, and a number of aggregated financial services."@en .

biz:commercial-banking a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Commercial Banking"@en ;
    skos:prefLabel "Commercial Banking"@en ;
    skos:definition "Banking services oriented towards businesses and corporate entities, including lending, treasury management, and commercial credit."@en .

biz:insurance a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Insurance"@en ;
    skos:prefLabel "Insurance"@en ;
    skos:definition "The business of providing contracts of insurance, offering financial protection or reimbursement against losses."@en .

#####################################################################
# KPI & Metric Decoupling Framework
#####################################################################

biz:MetricDirection a owl:Class ;
    rdfs:label "Metric Direction"@en ;
    rdfs:comment "A class representing the direction of movement of a measured metric (Increase or Decrease)."@en .

biz:Increase a biz:MetricDirection ;
    rdfs:label "Increase"@en .

biz:Decrease a biz:MetricDirection ;
    rdfs:label "Decrease"@en .

biz:associatedMetric a owl:ObjectProperty ;
    rdfs:label "associated metric"@en ;
    rdfs:comment "Links a KPI measurement to the abstract SKOS Concept representing the metric itself."@en ;
    rdfs:range skos:Concept .

biz:changeDirection a owl:ObjectProperty ;
    rdfs:label "change direction"@en ;
    rdfs:comment "Links a KPI measurement to its MetricDirection (Increase or Decrease)."@en ;
    rdfs:range biz:MetricDirection .

biz:measuredInYear a owl:DatatypeProperty ;
    rdfs:label "measured in year"@en ;
    rdfs:comment "The specific calendar year in which the KPI metric was measured."@en ;
    rdfs:range xsd:integer .

biz:metricValue a owl:DatatypeProperty ;
    rdfs:label "metric value"@en ;
    rdfs:comment "The quantitative value of the metric change (e.g., 0.14 for 14%, 1.3 for 1.3x). Always paired with biz:metricUnit."@en ;
    rdfs:range xsd:decimal .

biz:metricUnit a owl:DatatypeProperty ;
    rdfs:label "metric unit"@en ;
    rdfs:comment "The unit or scale of the biz:metricValue. Controlled enumeration: 'percentage' (0–1 scale), 'multiplier' (ratio relative to baseline), 'currency-USD', 'currency-local'."@en ;
    rdfs:range xsd:string .

#####################################################################
# VCR 0011 — classes and properties admitted from the full-wiki ACE harvest
#####################################################################

biz:AgencyModality a owl:Class ;
    rdfs:label "Agency Modality"@en ;
    rdfs:comment "Whether a white-label travel platform's integration runs through a travel agency or direct. A commercial distribution-relationship choice, not a technical one — stays biz: even though DeploymentModel/IntegrationModel (the same 'MUSCLE product config' shape) moved to swe:. Closed enumeration — see VCR 0011."@en ;
    owl:oneOf ( biz:with-agency biz:without-agency ) .

biz:with-agency a owl:NamedIndividual, biz:AgencyModality ;
    rdfs:label "With Agency"@en .

biz:without-agency a owl:NamedIndividual, biz:AgencyModality ;
    rdfs:label "Without Agency"@en .

biz:BaseConfiguration a owl:Class ;
    rdfs:subClassOf biz:Configuration ;
    rdfs:label "Base Configuration"@en ;
    rdfs:comment "The fallback pricing configuration assigned to a user who belongs to no segment, or whose segment has no active strategy. A generic default/fallback-configuration pattern, not MUSCLE-specific. See VCR 0011. Subclassed under biz:Configuration (VCR 0012) — the general class any applied config belongs to."@en .

biz:Cardholder a owl:Class ;
    rdfs:label "Cardholder"@en ;
    rdfs:comment "A bank's end-user who holds and uses loyalty points and receives discounts. See VCR 0011."@en .

biz:SalesChannel a owl:Class ;
    rdfs:label "Sales Channel"@en ;
    rdfs:comment "How a company reaches its customers commercially (e.g. AstroPay operates in a sales channel). Distinct from biz:RedemptionChannel, which is how a cardholder redeems loyalty points — a different concept despite the name similarity. See VCR 0011."@en .

biz:Customer a owl:Class ;
    rdfs:label "Customer"@en ;
    rdfs:comment "A bank's end-user in an acquisition context. Distinct from biz:Cardholder (a loyalty-specific role), though likely the same underlying person. See VCR 0011."@en .

biz:Discount a owl:Class ;
    rdfs:label "Discount"@en ;
    rdfs:comment "A cash/points discount a partner merchant offers a cardholder, which can trigger a swe:UIComponent notification. See VCR 0011."@en .

biz:LoyaltyProgramType a owl:Class ;
    rdfs:label "Loyalty Program Type"@en ;
    rdfs:comment "Loyalty-card program ownership structure. Renamed from the too-generic 'ProgramType' — see VCR 0011. Closed enumeration."@en ;
    owl:oneOf ( biz:bank-owned biz:co-branded ) .

biz:bank-owned a owl:NamedIndividual, skos:Concept, biz:LoyaltyProgramType ;
    rdfs:label "Bank-Owned"@en ;
    rdfs:comment "A loyalty program owned directly by the bank."@en ;
    skos:prefLabel "Bank-Owned"@en ;
    skos:definition "A loyalty program owned and operated directly by the bank, as opposed to jointly with a partner."@en .

biz:co-branded a owl:NamedIndividual, skos:Concept, biz:LoyaltyProgramType ;
    rdfs:label "Co-Branded"@en ;
    rdfs:comment "A loyalty program co-branded with a partner."@en ;
    skos:prefLabel "Co-Branded"@en ;
    skos:definition "A loyalty program jointly branded and operated with a partner organization, as opposed to owned solely by the bank."@en .

biz:PaymentType a owl:Class ;
    rdfs:label "Payment Type"@en ;
    rdfs:comment "How a redemption/transaction is funded. Closed enumeration — see VCR 0011."@en ;
    owl:oneOf ( biz:points-only biz:mixed-payment biz:cash-only ) .

biz:points-only a owl:NamedIndividual, biz:PaymentType ;
    rdfs:label "Points Only"@en ;
    rdfs:comment "A redemption funded entirely by loyalty points."@en .

biz:mixed-payment a owl:NamedIndividual, skos:Concept, biz:PaymentType ;
    rdfs:label "Mixed Payment"@en ;
    rdfs:comment "A redemption funded by a mix of points and cash."@en ;
    skos:prefLabel "Mixed Payment"@en ;
    skos:altLabel "Points + Cash"@en ;
    skos:definition "A redemption transaction where the customer uses a combination of loyalty points and cash to complete the purchase."@en .

biz:cash-only a owl:NamedIndividual, biz:PaymentType ;
    rdfs:label "Cash Only"@en ;
    rdfs:comment "A redemption funded entirely in cash."@en .

biz:RedemptionChannel a owl:Class ;
    rdfs:label "Redemption Channel"@en ;
    rdfs:comment "Which channel a cardholder redeems loyalty points through: travel or retail. See VCR 0011."@en ;
    owl:oneOf ( biz:travel-channel biz:retail-channel ) .

biz:travel-channel a owl:NamedIndividual, biz:RedemptionChannel ;
    rdfs:label "Travel Channel"@en .

biz:retail-channel a owl:NamedIndividual, biz:RedemptionChannel ;
    rdfs:label "Retail Channel"@en .

biz:Segment a owl:Class ;
    rdfs:label "Segment"@en ;
    rdfs:comment "A named group of users, defined via CSV upload, that a pricing-strategy targets exactly one of. See VCR 0011."@en .

biz:Transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "A point-redemption/purchase event during which segment and pricing-strategy rules apply. See VCR 0011."@en .

biz:TravelVertical a owl:Class ;
    rdfs:label "Travel Vertical"@en ;
    rdfs:comment "Which travel product line a booking flow routes to. See VCR 0011. Amended by VCR 0012 to add biz:cruises — cruise-product was found to be a missing member of this closed enumeration, not a new class."@en ;
    owl:oneOf ( biz:flights biz:hotels biz:cars biz:cruises ) .

biz:flights a owl:NamedIndividual, biz:TravelVertical ;
    rdfs:label "Flights"@en .

biz:hotels a owl:NamedIndividual, biz:TravelVertical ;
    rdfs:label "Hotels"@en .

biz:cars a owl:NamedIndividual, biz:TravelVertical ;
    rdfs:label "Cars"@en .

biz:cruises a owl:NamedIndividual, biz:TravelVertical ;
    rdfs:label "Cruises"@en ;
    skos:prefLabel "Cruises"@en ;
    skos:definition "The cruise-booking travel vertical: sea-voyage travel products offered alongside flights, hotels, and cars."@en .

biz:sku a skos:Concept ;
    rdfs:label "SKU"@en ;
    skos:prefLabel "SKU"@en ;
    skos:altLabel "Stock Keeping Unit"@en ;
    skos:definition "A retail stock-identifier concept, inherited verbatim from the source project's biz: module (VCR-0001) — not tied to that project's pricing-strategy vocabulary, which was not carried over. Possible future reuse of schema:gtin, unresolved."@en .

biz:assigns a owl:ObjectProperty ;
    rdfs:label "assigns"@en ;
    rdfs:comment "The subject assigns the object to something else (e.g. a bank-administrator assigns a segment to a user; the system assigns a base-configuration as fallback)."@en .

biz:belongsToSegment a owl:ObjectProperty ;
    rdfs:label "belongs to segment"@en ;
    rdfs:comment "A user belongs to a segment, or to none (triggering base-configuration fallback)."@en ;
    rdfs:domain org:Role ;
    rdfs:range biz:Segment .

biz:buys a owl:ObjectProperty ;
    rdfs:label "buys"@en ;
    rdfs:comment "The subject purchases the object (retail context)."@en .

biz:creates a owl:ObjectProperty ;
    rdfs:label "creates"@en ;
    rdfs:comment "The subject brings the object into existence (e.g. a bank-administrator creates a pricing-strategy or a user)."@en .

biz:defines a owl:ObjectProperty ;
    rdfs:label "defines"@en ;
    rdfs:comment "The subject specifies the object's configuration (e.g. a csv-upload defines a segment)."@en .

biz:groups a owl:ObjectProperty ;
    rdfs:label "groups"@en ;
    rdfs:comment "The subject collects multiple objects together (e.g. a segment groups users; a loyalty-hub groups rewards)."@en .

biz:offers a owl:ObjectProperty ;
    rdfs:label "offers"@en ;
    rdfs:comment "The subject makes the object available (a business line, a product, a discount) — an organization to its market, or a software application to its users. Domain widened under VCR 0015 after White-Label-Travel-Platform's own product-catalog facts (inventory, cruises, packages) surfaced a HermiT disjointness violation against the original Organization-only domain."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( org:Organization schema:SoftwareApplication ) ] ;
    rdfs:range skos:Concept .

biz:operatesIn a owl:ObjectProperty ;
    rdfs:label "operates in"@en ;
    rdfs:comment "The subject organization operates in the object geography, industry, or channel."@en ;
    rdfs:domain org:Organization .

biz:owns a owl:ObjectProperty ;
    rdfs:label "owns"@en ;
    rdfs:comment "The subject organization owns the object asset or system."@en ;
    rdfs:domain org:Organization .

biz:performs a owl:ObjectProperty ;
    rdfs:label "performs"@en ;
    rdfs:comment "The subject carries out the object action (e.g. a user performs two-factor-authentication; MUSCLE performs troubleshooting)."@en .

biz:configures a owl:ObjectProperty ;
    rdfs:label "configures"@en ;
    rdfs:comment "The subject sets a configuration value on the object (e.g. a bank-administrator configures a pricing-strategy's name/modality/fiat-value-reference)."@en .

biz:tracks a owl:ObjectProperty ;
    rdfs:label "tracks"@en ;
    rdfs:comment "The subject reporting surface tracks the object KPI."@en ;
    rdfs:range fibo-fnd-utl-alx:KeyPerformanceIndicator .

biz:subsidiaryOf a owl:ObjectProperty ;
    rdfs:label "subsidiary of"@en ;
    rdfs:comment "The subject organization is a corporate subsidiary of the object organization."@en ;
    rdfs:domain org:Organization ;
    rdfs:range org:Organization .

biz:bankUniqId a owl:DatatypeProperty ;
    rdfs:label "bank unique ID"@en ;
    rdfs:comment "A user's unique bank-assigned identifier; every csv-upload must contain exactly one such column."@en ;
    rdfs:domain org:Role ;
    rdfs:range xsd:string .

biz:filtersBy a owl:ObjectProperty ;
    rdfs:label "filters by"@en ;
    rdfs:comment "A reporting module's data can be filtered by this dimension (e.g. category, date range). Range intentionally left open (owl:Thing) — it spans multiple unrelated enum/class types. The source project this property was inherited from (VCR-0001) validated a closed filter set via a shape not carried over here; no equivalent shape has been written in this deployment yet."@en ;
    rdfs:domain swe:ReportingModule .

#####################################################################
# VCR 0012 — classes admitted from the pre-VCR-0011 backlog review
#####################################################################

#####################################################################
# VCR 0012 — industry/business-line tags (skos:Concept), same shape
# as the VCR-0002 block above (biz:retail-banking etc.)
#####################################################################

biz:cash a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Cash"@en ;
    skos:prefLabel "Cash"@en ;
    skos:definition "A payment component consisting of real-world currency, as opposed to loyalty points, used in a mixed-payment redemption."@en .

biz:commercial-lending a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Commercial Lending"@en ;
    skos:prefLabel "Commercial Lending"@en ;
    skos:definition "The business of extending credit and loans to businesses and corporate entities, as opposed to individual consumers."@en .

biz:department-store a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Department Store"@en ;
    skos:prefLabel "Department Store"@en ;
    skos:definition "A large retail establishment offering a wide variety of merchandise organized into separate departments."@en .

biz:digital-innovation a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Digital Innovation"@en ;
    skos:prefLabel "Digital Innovation"@en ;
    skos:definition "The application of new digital technologies and approaches to improve or transform a bank's products and customer experience."@en .

biz:e-commerce a owl:NamedIndividual, skos:Concept ;
    rdfs:label "E-Commerce"@en ;
    skos:prefLabel "E-Commerce"@en ;
    skos:definition "The buying and selling of goods or services, and the transfer of money, over the internet."@en .

biz:education a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Education"@en ;
    skos:prefLabel "Education"@en ;
    skos:definition "The industry sector encompassing schools, universities, and other institutions providing instruction or training."@en .

biz:financial-services a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Financial Services"@en ;
    skos:prefLabel "Financial Services"@en ;
    skos:definition "The industry sector encompassing economic services provided by the finance industry, including retail banking, insurance, and wealth management."@en .

biz:fintech-industry a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Fintech Industry"@en ;
    skos:prefLabel "Fintech Industry"@en ;
    skos:definition "The industry sector applying technology to improve and automate the delivery and use of financial services."@en .

biz:gaming a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Gaming"@en ;
    skos:prefLabel "Gaming"@en ;
    skos:definition "The industry sector encompassing video games, online gaming, and gambling entertainment."@en .

biz:trading-platform a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Trading Platform"@en ;
    skos:prefLabel "Trading Platform"@en ;
    skos:definition "The industry sector encompassing venues and platforms for trading financial instruments such as stocks, currencies, or commodities."@en .

biz:healthcare a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Healthcare"@en ;
    skos:prefLabel "Healthcare"@en ;
    skos:definition "The industry sector encompassing the maintenance or improvement of health via the prevention, diagnosis, and treatment of illness."@en .

biz:hospitality a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Hospitality"@en ;
    skos:prefLabel "Hospitality"@en ;
    skos:definition "The industry sector encompassing lodging, food and beverage service, event planning, and tourism."@en .

biz:payments-industry a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Payments Industry"@en ;
    skos:prefLabel "Payments Industry"@en ;
    skos:definition "The industry sector encompassing the processing and settlement of financial transactions between parties."@en .

biz:pharmacy a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Pharmacy"@en ;
    skos:prefLabel "Pharmacy"@en ;
    skos:definition "A retail-vertical sub-tag for stores primarily dispensing prescription medication and related health products."@en .

biz:retail a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Retail"@en ;
    skos:prefLabel "Retail"@en ;
    skos:definition "The industry sector encompassing the sale of goods directly to consumers."@en .

biz:supermarket a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Supermarket"@en ;
    skos:prefLabel "Supermarket"@en ;
    skos:definition "A large self-service retail store selling a wide range of food and household products."@en .

biz:banking-industry a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Banking Industry"@en ;
    skos:prefLabel "Banking Industry"@en ;
    skos:definition "The industry sector encompassing deposit-taking, lending, and related financial intermediation services provided by banks."@en .

biz:behavioral-science a owl:NamedIndividual, skos:Concept ;
    rdfs:label "Behavioral Science"@en ;
    skos:prefLabel "Behavioral Science"@en ;
    skos:definition "The academic field studying human decision-making, habits, and behavior; not MUSCLE-specific."@en .


# Banking / retail / commercial — `biz:` (12)

biz:AlternativePaymentMethod a owl:Class ;
    rdfs:label "Alternative Payment Method"@en ;
    rdfs:comment "A local, non-card payment method."@en .

biz:Branch a owl:Class ;
    rdfs:label "Branch"@en ;
    rdfs:comment "A physical bank branch location."@en .

biz:Chargeback a owl:Class ;
    rdfs:label "Chargeback"@en ;
    rdfs:comment "A reversal of a card transaction disputed by the cardholder or issuer."@en .

biz:ChannelRestriction a owl:Class ;
    rdfs:label "Channel Restriction"@en ;
    rdfs:comment "A restriction that gates a redemption channel."@en .

biz:LocationBoundary a owl:Class ;
    rdfs:label "Location Boundary"@en ;
    rdfs:comment "A geographic boundary restricting where a hotel strategy applies."@en .

biz:RetailCategory a owl:Class ;
    rdfs:label "Retail Category"@en ;
    rdfs:comment "A product category used to scope a retail restriction."@en .

biz:VirtualPrepaidCard a owl:Class ;
    rdfs:label "Virtual Prepaid Card"@en ;
    rdfs:comment "A virtual prepaid card product."@en .

biz:DefaultParameter a owl:Class ;
    rdfs:label "Default Parameter"@en ;
    rdfs:comment "A default setting established via a configuration form."@en .

biz:Configuration a owl:Class ;
    rdfs:label "Configuration"@en ;
    rdfs:comment "An applied set of settings for a bank's deployment."@en .

biz:ConfigurationForm a owl:Class ;
    rdfs:label "Configuration Form"@en ;
    rdfs:comment "The intake form a bank completes to supply its configuration."@en .

biz:EmergingMarket a owl:Class ;
    rdfs:label "Emerging Market"@en ;
    rdfs:comment "A market MUSCLE's product targets as an emerging economy."@en .

# Pricing / business metrics — `biz:` (13)

biz:CostEfficiency a owl:Class ;
    rdfs:label "Cost Efficiency"@en ;
    rdfs:comment "A measure of cost efficiency aligned against customer value."@en .

biz:CustomerValue a owl:Class ;
    rdfs:label "Customer Value"@en ;
    rdfs:comment "The value delivered to a customer, aligned against cost efficiency."@en .

biz:Engagement a owl:Class ;
    rdfs:label "Engagement"@en ;
    rdfs:comment "Customer engagement across channels, personalized and optimized. Moved here from Bucket A — it's a distinct metric, same shape as `cost-efficiency`/`customer-value`/`perceived-value`, not a duplicate of either."@en .

biz:MarginControl a owl:Class ;
    rdfs:label "Margin Control"@en ;
    rdfs:comment "The practice of managing program profitability margins."@en .

biz:PerceivedValue a owl:Class ;
    rdfs:label "Perceived Value"@en ;
    rdfs:comment "The perceived value of a loyalty program to its members."@en .

biz:PointBalance a owl:Class ;
    rdfs:label "Point Balance"@en ;
    rdfs:comment "A user's current loyalty-point balance."@en .

biz:PointLiability a owl:Class ;
    rdfs:label "Point Liability"@en ;
    rdfs:comment "The bank's outstanding financial liability from issued points."@en .

biz:PointRedemption a owl:Class ;
    rdfs:label "Point Redemption"@en ;
    rdfs:comment "A redemption of loyalty points."@en .

biz:Profitability a owl:Class ;
    rdfs:label "Profitability"@en ;
    rdfs:comment "The program's overall profitability."@en .

biz:RedemptionJourney a owl:Class ;
    rdfs:label "Redemption Journey"@en ;
    rdfs:comment "The end-to-end user journey through a redemption."@en .

biz:RoutePrice a owl:Class ;
    rdfs:label "Route Price"@en ;
    rdfs:comment "A fixed price, in points, defined per `travel:Route` (domain resolved — see the Travel industry group; was an Open Item, now fixed)."@en .

biz:TargetedIncentive a owl:Class ;
    rdfs:label "Targeted Incentive"@en ;
    rdfs:comment "An incentive targeted at a specific segment."@en .

biz:ValueOptimization a owl:Class ;
    rdfs:label "Value Optimization"@en ;
    rdfs:comment "The practice of suggesting optimal points/cash combinations."@en .

# Reporting / support / ops — `swe:`/`biz:` (10)

biz:PricingStrategyAlert a owl:Class ;
    rdfs:label "Pricing Strategy Alert"@en ;
    rdfs:comment "An alert raised about a pricing strategy."@en .

biz:SharedResponsibilityModel a owl:Class ;
    rdfs:label "Shared Responsibility Model"@en ;
    rdfs:comment "The model describing which party is responsible for what."@en .

biz:Auditing a owl:Class ;
    rdfs:label "Auditing"@en ;
    rdfs:comment "The activity of auditing platform actions."@en .

# Process / activity — `rdfs:subClassOf prov:Activity` (8)

biz:Process a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Process"@en ;
    rdfs:comment "A named, multi-stage business process (e.g. onboarding). `prov:Activity` is the upstream term being reused — `biz:Process` is a *subclass* of it, not a parallel term. The reuse isn't 'use `prov:Activity` bare instead': `Activity` alone can't say 'this thing has stages' (that needs `process-stage`/`protocol-step` as parts, via `includesStage`/`includesStep`, C3). The subclass is what makes that structure expressible — dropping it back to bare `prov:Activity` would lose the one thing `process` actually adds."@en .

biz:ProcessStage a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Process Stage"@en ;
    rdfs:comment "One stage within a `biz:Process`."@en .

biz:VirtualSession a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Virtual Session"@en ;
    rdfs:comment "A remote meeting held as part of a process (e.g. onboarding)."@en .

biz:ProtocolStep a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Protocol Step"@en ;
    rdfs:comment "One numbered step of a fixed protocol."@en .

biz:DisputeProcess a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Dispute Process"@en ;
    rdfs:comment "The process of handling a payment dispute. No FIBO fit exists — same finding as `chargeback`; a clean PROV-O fit once treated as an activity rather than a payments concept."@en .

# Onboarding documents — `biz:` (5)

biz:BrandBook a owl:Class ;
    rdfs:label "Brand Book"@en ;
    rdfs:comment "A bank-provided brand-guidelines document."@en .

biz:EmailConfirmation a owl:Class ;
    rdfs:label "Email Confirmation"@en ;
    rdfs:comment "The formal email confirming applied configuration."@en .

biz:JourneyMapping a owl:Class ;
    rdfs:label "Journey Mapping"@en ;
    rdfs:comment "The document mapping every step of the redemption journey."@en .

biz:TransactionalEmail a owl:Class ;
    rdfs:label "Transactional Email"@en ;
    rdfs:comment "A transactional email (booking confirmation, cancellation)."@en .

biz:WelcomeEmail a owl:Class ;
    rdfs:label "Welcome Email"@en ;
    rdfs:comment "A welcome email sent to a new user."@en .

# AI / product platform — `swe:` (12)

biz:DynamicPricing a owl:Class ;
    rdfs:label "Dynamic Pricing"@en ;
    rdfs:comment "The commercial practice of adjusting route/booking cost dynamically."@en .

biz:LoyaltyProgram a owl:Class ;
    rdfs:subClassOf schema:Product ;
    rdfs:label "Loyalty Program"@en ;
    rdfs:comment "A general loyalty program. Subclassed under schema:Product so biz:provides (domain org:Organization, range schema:Product) applies directly — see bank-loyalty-program, Bucket A."@en .

# Miscellaneous native nouns (10)

biz:Demonstration a owl:Class ;
    rdfs:label "Demonstration"@en ;
    rdfs:comment "A platform demonstration used for sales/onboarding."@en .

biz:BehavioralHabit a owl:Class ;
    rdfs:label "Behavioral Habit"@en ;
    rdfs:comment "A user behavioral habit analyzed by the engine. Renamed per direct instruction."@en .

biz:UserPreference a owl:Class ;
    rdfs:label "User Preference"@en ;
    rdfs:comment "A user preference analyzed by the engine. Renamed per direct instruction."@en .

biz:UserTaste a owl:Class ;
    rdfs:label "User Taste"@en ;
    rdfs:comment "A user taste analyzed by the engine. Renamed per direct instruction."@en .

biz:PersonallyIdentifiableInformation a owl:Class ;
    rdfs:label "Personally Identifiable Information"@en ;
    rdfs:comment "Personally identifiable cardholder information. schema.org has no PII/data-privacy class."@en .

biz:RecommendationTrigger a owl:Class ;
    rdfs:label "Recommendation Trigger"@en ;
    rdfs:comment "A trigger condition for a smart recommendation."@en .

biz:Reward a owl:Class ;
    rdfs:label "Reward"@en ;
    rdfs:comment "A reward priced dynamically by route or segment."@en .

