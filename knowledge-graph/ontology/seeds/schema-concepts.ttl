aiw:subcategory-terminal-coding-agent a skos:Concept ;
    skos:prefLabel "terminal-coding-agent"@en ;
    skos:definition "CLI-based AI coding agents that run in the terminal, operating autonomously across file editing, shell commands, and tool use without a graphical IDE."@en ;
    skos:notation "terminal-coding-agent" ;
    skos:broader aiw:domain-coding ;
