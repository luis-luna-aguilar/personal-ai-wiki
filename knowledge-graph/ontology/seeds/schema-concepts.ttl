aiw:subcategory-agent-toolkits a skos:Concept ;
    skos:prefLabel "agent-toolkits"@en ;
    skos:definition "Toolkits that package a specific developer platform's docs, schemas, validation, and related capabilities for AI coding tools via plugins, skills, or MCP servers."@en ;
