    skos:inScheme aiw:domain-scheme .

aiw:subcategory-spec-driven-development a skos:Concept ;
    skos:prefLabel "spec-driven-development"@en ;
    skos:definition "Tools and workflows where a structured natural-language spec is authored before (and often alongside) code, intended as the primary artifact guiding AI coding agents."@en ;
    skos:notation "spec-driven-development" ;
    skos:broader aiw:domain-coding ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-agentic-coding-workspace a skos:Concept ;
    skos:prefLabel "agentic-coding-workspace"@en ;
    skos:definition "Coding tools whose primary UI is built around managing one or more AI coding agents (local and/or cloud), rather than file-centric editing with AI assistance bolted on."@en ;
    skos:notation "agentic-coding-workspace" ;
    skos:broader aiw:domain-coding ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-agent-orchestration a skos:Concept ;
    skos:prefLabel "agent-orchestration"@en ;
    skos:definition "Platforms, surfaces, and patterns for running, supervising, or internally routing AI agents — spanning hosted runtimes, human-supervision UIs, and multi-model coordination patterns within a single agentic task."@en ;
    skos:notation "agent-orchestration" ;
    skos:broader aiw:domain-agents ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-coding-model a skos:Concept ;
    skos:prefLabel "coding-model"@en ;
    skos:definition "A foundation model trained or specialized for code generation, completion, or agentic coding tasks."@en ;
    skos:notation "coding-model" ;
    skos:broader aiw:domain-models ;
    skos:broader aiw:domain-coding ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-frontier-model a skos:Concept ;
    skos:prefLabel "frontier-model"@en ;
    skos:definition "General-purpose frontier models competing on broad capability rather than narrow specialization."@en ;
    skos:notation "frontier-model" ;
    skos:broader aiw:domain-models ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-open-weight-model a skos:Concept ;
    skos:prefLabel "open-weight-model"@en ;
    skos:definition "General-purpose or broadly capable foundation models released with open or open-ish weights, where the key state-of question is availability and deployment control rather than a narrow task specialization."@en ;
    skos:notation "open-weight-model" ;
    skos:broader aiw:domain-models ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-legal-ai a skos:Concept ;
    skos:prefLabel "legal-ai"@en ;
    skos:definition "End-to-end AI products built specifically for legal workflows (matters, contracts, research, drafting), as distinct from generic horizontal assistants applied to legal use cases."@en ;
    skos:notation "legal-ai" ;
    skos:broader aiw:domain-legal ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-agentic-devops a skos:Concept ;
    skos:prefLabel "agentic-devops"@en ;
    skos:definition "Tools and control planes that let humans or agents provision, diagnose, operate, verify, and safely mutate infrastructure through repeatable, auditable interfaces — spanning provisioning CLIs, Kubernetes diagnostics, approval-gated execution layers, and post-deploy verification."@en ;
    skos:notation "agentic-devops" ;
    skos:broader aiw:domain-coding ;
    skos:broader aiw:domain-agents ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-computer-use a skos:Concept ;
    skos:prefLabel "computer-use"@en ;
    skos:definition "Autonomous agents that orchestrate models, connect to external services, and execute complex workflows through application interfaces — going beyond API tool-calling to interact with systems as a human would."@en ;
    skos:notation "computer-use" ;
    skos:broader aiw:domain-computer-use ;
    skos:inScheme aiw:subcategory-scheme .

aiw:subcategory-ai-assistant a skos:Concept ;
    skos:prefLabel "ai-assistant"@en ;
