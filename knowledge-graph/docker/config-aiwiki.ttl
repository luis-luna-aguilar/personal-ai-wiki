# GENERATED by gen-config.sh from kg.config.yaml — do not edit by hand.
#
# Fuseki assembler config for the `aiwiki` dataset WITH query-time reasoning.
#
# Wraps an in-memory base model in an OWLMicro inference model. OWLMicro
# materializes: rdfs:subClassOf / subPropertyOf, domain/range, owl:inverseOf,
# owl:SymmetricProperty, owl:TransitiveProperty, sameAs. That makes the rules
# in the authored vocabulary modules visible at query time — e.g. a symmetric
# integrates-with relation and inverse property pairs are inferred, and
# upstream-typed individuals are recognised under their superclasses.
#
# The store is in-memory and repopulated by scripts/rebuild.sh (or
# load-fuseki.sh) from the wiki Turtle — the wiki is the system of record,
# Fuseki is a derived query surface. Deep contradiction checking is done at
# build/ingestion time with HermiT (see scripts/validate-ingestion.sh), not
# here; this reasoner is for query-time entailment.

@prefix :        <#> .
@prefix fuseki:  <http://jena.apache.org/fuseki#> .
@prefix ja:      <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

:service a fuseki:Service ;
    fuseki:name "aiwiki" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r  ; fuseki:name "get" ] ;
    fuseki:dataset :dataset .

:dataset a ja:RDFDataset ;
    ja:defaultGraph :infModel .

:infModel a ja:InfModel ;
    ja:baseModel [ a ja:MemoryModel ] ;
    ja:reasoner [
        ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLMicroFBRuleReasoner>
    ] .
