# Local environment variables — never commit
.env

# OAuth tokens and client credentials — never commit
scripts/gmail_credentials/*-client.json
scripts/gmail_credentials/*-token.json
scripts/gmail_credentials/*-token.json.*

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/

# OS
.DS_Store

# Obsidian local vault settings and workspace state
.obsidian/

# Podcast build output (generated from wiki content)
podcast/out/

# Private personal notes — track structure, not content
personal/**
!personal/**/
!personal/**/.gitkeep

# Agents MCP runtime artifacts
agents/logs/
agents/mcp/config.local.toml

# temp files
tmp/
