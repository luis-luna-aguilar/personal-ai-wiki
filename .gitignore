# Local environment variables — never commit
.env

# OAuth tokens and client credentials — never commit
scripts/gmail_credentials/*-client.json
scripts/gmail_credentials/*-token.json
scripts/gmail_credentials/*-token.json.*

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/

# OS
.DS_Store

# Obsidian local vault settings and workspace state
.obsidian/

# Podcast build output (generated from wiki content)
podcast/out/

# Private personal notes — track structure, not content
personal/**
!personal/**/
!personal/**/.gitkeep

# Agents MCP runtime artifacts
agents/logs/
agents/mcp/config.local.toml

# temp files
tmp/

# Knowledge Graph build artifacts (merged from knowledge-graph/kg-layer.gitignore.snippet
# at deploy, names aligned to knowledge-graph/kg.config.yaml → ontology.*)
knowledge-graph/tools/robot.jar
knowledge-graph/tools/apache-jena-*/
knowledge-graph/ontology/aiw-tbox.merged.ttl
knowledge-graph/ontology/extracts/*-module.ttl
knowledge-graph/scripts/__pycache__/
knowledge-graph/scripts/lexicon.gen.ulex
knowledge-graph/docker/.env
