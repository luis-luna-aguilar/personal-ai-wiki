# Gmail OAuth client credentials
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Copy this file to .env and fill in your values — never commit .env

# AI Gmail account
AI_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
AI_GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret

# Personal Gmail account
PERSONAL_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
PERSONAL_GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret
